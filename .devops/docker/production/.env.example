# Database credentials
POSTGRES_PASSWORD=your_secure_postgres_password
MONGO_PASSWORD=your_secure_mongo_password

# Application secrets (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=your_64_character_secret_key_base

# Application configuration
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
TZ=UTC

# The app's own Oban traces and Stats metrics. Set false to disable both.
TRIFLE_OBSERVABILITY_ENABLED=true

# Optional Trifle.Traces filesystem payload storage. Leave blank for metadata-only traces.
# Keep the path under /home/app/uploads to use the persistent app_uploads volume.
TRIFLE_TRACES_STORAGE_PATH=/home/app/uploads/traces
TRIFLE_TRACES_RETENTION_DAYS=7
TRIFLE_TRACES_GZIP=true

# Optional: SSL configuration
# FORCE_SSL=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
