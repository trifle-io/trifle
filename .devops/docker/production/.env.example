# Database credentials
POSTGRES_PASSWORD=your_secure_postgres_password
MONGO_PASSWORD=your_secure_mongo_password

# Application secrets (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=your_64_character_secret_key_base

# Application configuration
PHX_HOST=localhost
PORT=4000
POOL_SIZE=10
TZ=UTC

# The app's own Oban traces and Stats metrics. Set false to disable both.
TRIFLE_OBSERVABILITY_ENABLED=true

# Trace payload storage: none, file, or s3. An empty backend derives file from
# a nonempty storage path, otherwise none. These settings affect internal traces.
TRIFLE_TRACES_STORAGE_BACKEND=
# Keep the path under /home/app/uploads to use the persistent app_uploads volume.
TRIFLE_TRACES_STORAGE_PATH=/home/app/uploads/traces
TRIFLE_TRACES_RETENTION_DAYS=7
TRIFLE_TRACES_GZIP=true
TRIFLE_TRACES_MANAGE_S3_LIFECYCLE=true

# S3-compatible storage (used only with TRIFLE_TRACES_STORAGE_BACKEND=s3).
# Buckets must already exist. Supply one name or a comma-separated list.
TRIFLE_TRACES_S3_ENDPOINT=
TRIFLE_TRACES_S3_BUCKETS=
TRIFLE_TRACES_S3_REGION=us-east-1
TRIFLE_TRACES_S3_ACCESS_KEY_ID=
TRIFLE_TRACES_S3_SECRET_ACCESS_KEY=
TRIFLE_TRACES_S3_PREFIX=traces

# Optional: SSL configuration
# FORCE_SSL=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
