<div class="relative isolate min-h-screen overflow-hidden bg-[#10130f] text-[#ebf1df]">
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(250,204,21,0.14),transparent_26%),radial-gradient(circle_at_bottom_right,rgba(134,239,172,0.13),transparent_34%)]" />
    <div class="absolute inset-0 opacity-35 [background-image:linear-gradient(rgba(190,242,100,0.08)_1px,transparent_1px),linear-gradient(90deg,rgba(190,242,100,0.08)_1px,transparent_1px)] [background-size:2.75rem_2.75rem]" />
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-lime-200/35 to-transparent" />
  </div>

  <main class="relative mx-auto flex min-h-screen max-w-6xl items-center px-6 py-12 sm:py-16">
    <section class="w-full rounded-[2rem] border border-lime-100/10 bg-[#141815]/88 p-4 shadow-[0_42px_120px_-56px_rgba(0,0,0,0.85)] ring-1 ring-lime-100/5 backdrop-blur-sm sm:p-6 lg:p-8">
      <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="rounded-[1.6rem] border border-lime-100/10 bg-[#171d18] p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-3 text-[0.72rem] font-semibold uppercase tracking-[0.26em] text-[#a9bd8b]">
            <span class="inline-flex items-center gap-2 rounded-full border border-lime-100/10 bg-[#10140f] px-3 py-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-lime-300 shadow-[0_0_16px_rgba(190,242,100,0.65)]" />
              Trifle // Lookup Miss
            </span>
            <span class="font-mono text-[#6d7b61]">status:404</span>
          </div>

          <div class="mt-8 grid gap-5 xl:grid-cols-[11rem_minmax(0,1fr)] xl:items-start">
            <div class="rounded-[1.45rem] border border-lime-100/10 bg-[#121710] p-5 shadow-[inset_0_1px_0_rgba(223,242,183,0.03)]">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#8fa179]">
                lookup_sector
              </p>
              <div class="mt-4 font-mono text-6xl font-semibold tracking-[-0.08em] text-[#dff2b7] sm:text-7xl">
                404
              </div>
              <div class="mt-5 space-y-2 font-mono text-xs text-[#c5d1b8]">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[#7f8d73]">route</span>
                  <span>unmapped</span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[#7f8d73]">scope</span>
                  <span>private?</span>
                </div>
                <div class="flex items-center justify-between gap-3">
                  <span class="text-[#7f8d73]">share</span>
                  <span>not found</span>
                </div>
              </div>
            </div>

            <div class="min-w-0 space-y-4">
              <p class="font-mono text-sm uppercase tracking-[0.28em] text-[#c7d7b0]">
                resource_lookup_failed()
              </p>
              <h1 class="max-w-xl text-4xl font-semibold tracking-tight text-[#f3f8ea] sm:text-5xl">
                That link did not resolve cleanly.
              </h1>
              <p class="max-w-xl text-base leading-7 text-[#b9c5ab]">
                The page is private, moved, or gone. If this was a dashboard link, it may only
                be visible to signed-in workspace members or through a published share link.
              </p>

              <div class="mt-8 space-y-4">
                <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
                  <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#8fa179]">
                    recovery_vector
                  </p>
                  <p class="mt-3 max-w-lg text-sm leading-6 text-[#d7e0cb]">
                    Re-open the workspace from home, or ask for a fresh public share link if this
                    page should be reachable outside the org.
                  </p>
                </div>

                <div class="flex flex-wrap gap-3">
                  <.link
                    href={~p"/"}
                    class="inline-flex items-center justify-center rounded-2xl border border-lime-300/30 bg-lime-300/14 px-5 py-3 text-sm font-semibold text-[#f2f8ea] transition hover:border-lime-200/45 hover:bg-lime-300/22 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#171d18]"
                  >
                    Open Home
                  </.link>
                  <.link
                    href={~p"/users/log_in"}
                    class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-3 text-sm font-semibold text-[#d4deca] transition hover:border-white/20 hover:bg-white/[0.06] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#171d18]"
                  >
                    Log In
                  </.link>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-[1.6rem] border border-lime-100/10 bg-[#0e120f]">
          <div class="flex items-center justify-between border-b border-lime-100/10 px-5 py-4">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-rose-300/85" />
              <span class="h-2.5 w-2.5 rounded-full bg-amber-300/85" />
              <span class="h-2.5 w-2.5 rounded-full bg-lime-300/85" />
            </div>
            <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#8fa179]">
              trace.log
            </p>
          </div>

          <div class="space-y-4 px-5 py-5 font-mono text-sm leading-6 text-[#dde6cf]">
            <p><span class="text-amber-300">boot</span> resolving requested resource</p>
            <p><span class="text-lime-300">info</span> checking route map and workspace access</p>
            <p>
              <span class="text-rose-300">fail</span> no visible resource matched this request
            </p>

            <div class="rounded-2xl border border-lime-100/10 bg-[#131814] p-4">
              <p class="text-[0.72rem] uppercase tracking-[0.24em] text-[#8fa179]">
                probable_causes
              </p>
              <ul role="list" class="mt-3 space-y-2 text-[#dde6cf]">
                <li>dashboard visibility is restricted to workspace members</li>
                <li>the link points to an outdated path</li>
                <li>the resource was removed or renamed</li>
              </ul>
            </div>

            <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
              <p class="text-[0.72rem] uppercase tracking-[0.24em] text-[#8fa179]">next_move</p>
              <p class="mt-3 text-[#dde6cf]">
                Sign in, open the workspace home, or ask the sender for a fresh public share link.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
